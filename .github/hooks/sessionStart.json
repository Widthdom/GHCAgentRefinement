{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/check-git-state/check-git-state.py",
        "powershell": "python .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/check-git-state/check-git-state.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/check-hook-temp-files/check-hook-temp-files.py",
        "powershell": "python .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/check-hook-temp-files/check-hook-temp-files.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "bash .github/hooks/helpers/events/sessionStart/check-python/check-python.sh",
        "powershell": "& ./.github/hooks/helpers/events/sessionStart/check-python/check-python.cmd",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/check-required-tools/check-required-tools.py",
        "powershell": "python .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/check-required-tools/check-required-tools.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/check-target-session/check-target-session.py",
        "powershell": "python .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/check-target-session/check-target-session.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/load-copilot-instructions/load-copilot-instructions.py",
        "powershell": "python .github/hooks/helpers/runner/run-hook.py .github/hooks/helpers/events/sessionStart/load-copilot-instructions/load-copilot-instructions.py"
      }
    ]
  }
}

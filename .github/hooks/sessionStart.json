{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/check-git-state/check_git_state.py",
        "powershell": "python .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/check-git-state/check_git_state.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/check-hook-temp-files/check_hook_temp_files.py",
        "powershell": "python .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/check-hook-temp-files/check_hook_temp_files.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "bash .github/hooks/helpers/events/sessionStart/check-python/check-python.sh",
        "powershell": "& ./.github/hooks/helpers/events/sessionStart/check-python/check-python.cmd",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/check-required-tools/check_required_tools.py",
        "powershell": "python .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/check-required-tools/check_required_tools.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/check-target-session/check_target_session.py",
        "powershell": "python .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/check-target-session/check_target_session.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/load-copilot-instructions/load_copilot_instructions.py",
        "powershell": "python .github/hooks/helpers/runner/run_hook.py .github/hooks/helpers/events/sessionStart/load-copilot-instructions/load_copilot_instructions.py"
      }
    ]
  }
}

{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "(?:functions\\.)?(?:bash|powershell)",
        "bash": "bash .github/hooks/helpers/events/preToolUse/block-commands/block-commands.sh",
        "powershell": "& ./.github/hooks/helpers/events/preToolUse/block-commands/block-commands.cmd",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "matcher": "(?:functions\\.)?(?:edit|create|insert|str_replace_editor|apply_patch)",
        "bash": "python3 .github/hooks/helpers/events/preToolUse/block-elided-rewrites/block-elided-rewrites.py",
        "powershell": "python .github/hooks/helpers/events/preToolUse/block-elided-rewrites/block-elided-rewrites.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "matcher": "(?:functions\\.)?(?:edit|create|insert|str_replace_editor|apply_patch)",
        "bash": "python3 .github/hooks/helpers/events/preToolUse/block-secret-writes/block-secret-writes.py",
        "powershell": "python .github/hooks/helpers/events/preToolUse/block-secret-writes/block-secret-writes.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "matcher": "(?:functions\\.)?(?:bash|powershell)",
        "bash": "python3 .github/hooks/helpers/events/preToolUse/block-shell-file-edits/block-shell-file-edits.py",
        "powershell": "python .github/hooks/helpers/events/preToolUse/block-shell-file-edits/block-shell-file-edits.py",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "matcher": "(?:functions\\.)?(?:edit|create|insert|str_replace_editor|apply_patch)",
        "bash": "python3 .github/hooks/helpers/events/preToolUse/require-read-before-edit/require-read-before-edit.py",
        "powershell": "python .github/hooks/helpers/events/preToolUse/require-read-before-edit/require-read-before-edit.py",
        "timeoutSec": 10
      }
    ]
  }
}

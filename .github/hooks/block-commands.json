{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "(?:functions\\.)?(?:bash|powershell)",
        "bash": "bash .github/hooks/helpers/block-commands/block-commands.sh",
        "powershell": "& ./.github/hooks/helpers/block-commands/block-commands.cmd",
        "timeoutSec": 10
      }
    ]
  }
}

[
  {
    "name": "Anthropic API key",
    "pattern": "\\bsk-ant-[A-Za-z0-9_-]{32,}"
  },
  {
    "name": "OpenAI API key",
    "pattern": "\\bsk-(?!ant-)(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{32,}"
  },
  {
    "name": "GitHub token",
    "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,})"
  },
  {
    "name": "AWS access key ID",
    "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
  },
  {
    "name": "Google API key",
    "pattern": "\\bAIza[0-9A-Za-z_-]{35}"
  },
  {
    "name": "Slack token",
    "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}"
  },
  {
    "name": "Stripe live key",
    "pattern": "\\b[rs]k_live_[0-9A-Za-z]{24,}"
  },
  {
    "name": "Private key",
    "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----"
  }
]
